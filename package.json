{
  "name": "vitepress-baton-touch",
  "version": "0.1.0",
  "private": true,
  "description": "VitePress 기반 인수인계 문서 템플릿 (S3 + CloudFront Basic Auth 배포)",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "build:lambda": "node scripts/build-lambda.mjs",
    "infra:apply": "npm run build:lambda && terraform -chdir=infra apply",
    "test": "npm run test:cf && npm run test:chat && npm run typecheck",
    "test:cf": "node scripts/test-cf-function.mjs",
    "test:chat": "node scripts/test-chat-handler.mjs",
    "typecheck": "tsc -p infra/lambda/tsconfig.json",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1176.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.3",
    "vitepress-plugin-llms": "^1.15.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "openai": "^7.63.0",
    "viewerjs": "^1.15.2"
  }
}
