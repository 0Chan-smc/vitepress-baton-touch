# cp terraform.tfvars.example terraform.tfvars 후 값을 채운다. (terraform.tfvars 는 git 에서 제외됨)
project_name = "handover-docs"
aws_region   = "ap-northeast-2"
bucket_name  = "my-handover-docs-bucket"

basic_auth_user     = "handover"
basic_auth_password = "change-me"

# 커스텀 도메인 사용 시 (인증서는 us-east-1 에 발급)
# domain_aliases      = ["docs.example.com"]
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxx"

# price_class = "PriceClass_200"

# 문서 Q&A 챗봇 (기본값 사용 시 생략 가능)
# chat_enabled  = true
# chat_provider = "openai"      # openai | anthropic
# chat_model    = "gpt-6-luna"  # 생략 시 제공사 기본값 (openai: gpt-6-luna, anthropic: claude-opus-5-5)
# chat_effort   = "low"
# chat_max_concurrency = 3     # 동시에 처리하는 질문 수 상한 (비용 폭주 방지)

# GitHub Actions 문서 자동 배포 (비워두면 배포 role 을 만들지 않음)
# github_repository           = "my-org/my-handover-docs"
# github_deploy_branch        = "main"
# create_github_oidc_provider = false   # 계정에 GitHub OIDC provider 가 없을 때만 true
# github_oidc_subject_prefix  = ""      # immutable subject 저장소면 아래 명령 결과로 설정
#   gh api repos/<owner>/<repo>/actions/oidc/customization/sub --jq .sub_claim_prefix
